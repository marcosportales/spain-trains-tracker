# Copy to .env and adjust. Defaults match docker-compose.yml.
POSTGRES_USER=stt
POSTGRES_PASSWORD=stt
POSTGRES_DB=stt
POSTGRES_PORT=5432

DATABASE_URL=postgresql://stt:stt@localhost:5432/stt
# Another local Postgres on 5432? Set POSTGRES_PORT=5433 above and use :5433 here.

# Optional enrichment from Renfe's undocumented visor JSON (Rolling stock, GPS for LD, Station estimates).
# Off by default; the app works on the Official feeds alone (ADR 0005).
VISOR_FEED_ENABLED=false

# Origin of the web app: the only origin the API allows via CORS.
WEB_ORIGIN=http://localhost:3000
